resource app_signature "application/x-vnd.hedgewars-launcher";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major = 1,
	middle = 1,
	minor = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Hedgewars",
	long_info = "Hedgewars, a turn-based artillery game; native Haiku port"
};
